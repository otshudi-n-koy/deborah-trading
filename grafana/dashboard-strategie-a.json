          "format": "table",
          "rawSql": "SELECT\n  ROUND(\n    COALESCE(\n      STDDEV(CASE WHEN rn <= 10 THEN pnl_pct END) /\n      NULLIF(STDDEV(pnl_pct), 0),\n      1.0\n    )::numeric, 3\n  ) AS regime_ratio\nFROM (\n  SELECT pnl_pct, ROW_NUMBER() OVER (ORDER BY exit_time DESC) as rn\n  FROM trades_a\n  WHERE strategie = 'A' AND pnl_pct IS NOT NULL\n) t",
          "refId": "A"
